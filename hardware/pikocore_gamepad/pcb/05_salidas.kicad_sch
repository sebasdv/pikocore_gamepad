    (symbol "pikocore_gamepad:JACK_AUDIO"
      (exclude_from_sim no) (in_bom yes) (on_board yes)
      (property "Reference" "J" (at 0 15.24 0) (effects (font (size 1.27 1.27))))
      (property "Value" "JACK_AUDIO" (at 0 -15.24 0) (effects (font (size 1.27 1.27))))
      (property "Footprint" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Datasheet" "https://www.sameskydevices.com/product/resource/sj1-353xng.pdf" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Description" "Jack 3.5mm estereo THT, CUI/Same Sky SJ1-3535NG (horizontal, 5 pines). Contacto de deteccion NC: el pin DET va a JACK_DET con pull-up y el firmware apaga el parlante al detectar plug. Se decide por firmware y no por hardware a proposito — permite politicas como 'auriculares puestos pero quiero oir el parlante igual', que un corte mecanico prohibe. PINOUT VERIFICADO contra el datasheet rev 1.06 (pagina 2, tabla del SJ1-3535NG): 1=sleeve, 2=tip, 3=ring, 4=tip switch, 5=ring switch. OJO: los switches son NC contra SU PROPIA senal (4 cierra contra 2, 5 cierra contra 3) y se abren al insertar; NO son contactos libres contra masa. Por eso DET usa el switch de RING y el canal derecho se toma del pin 3: ver la nota en el bloque del jack mas abajo." (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (symbol "JACK_AUDIO_0_1"
        (rectangle (start -7.62 12.7) (end 7.62 -12.7) (stroke (width 0.254) (type default)) (fill (type background)))
      )
      (symbol "JACK_AUDIO_1_1"
        (pin passive line (at -7.62 5.08 0) (length 2.54)
          (name "SLEEVE" (effects (font (size 1.27 1.27))))
          (number "S" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at -7.62 2.54 0) (length 2.54)
          (name "TIP" (effects (font (size 1.27 1.27))))
          (number "T" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at -7.62 0 0) (length 2.54)
          (name "RING" (effects (font (size 1.27 1.27))))
          (number "R" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at -7.62 -2.54 0) (length 2.54)
          (name "TIPSW" (effects (font (size 1.27 1.27))))
          (number "TN" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at -7.62 -5.08 0) (length 2.54)
          (name "DET" (effects (font (size 1.27 1.27))))
          (number "RN" (effects (font (size 1.27 1.27))))
        )
      )
    )
    (symbol "pikocore_gamepad:PAM8302A"
      (exclude_from_sim no) (in_bom yes) (on_board yes)
      (property "Reference" "U" (at 0 15.24 0) (effects (font (size 1.27 1.27))))
