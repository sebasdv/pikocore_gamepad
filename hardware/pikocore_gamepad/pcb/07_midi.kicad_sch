          (number "S" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at -7.62 2.54 0) (length 2.54)
          (name "TIP" (effects (font (size 1.27 1.27))))
          (number "T" (effects (font (size 1.27 1.27))))
