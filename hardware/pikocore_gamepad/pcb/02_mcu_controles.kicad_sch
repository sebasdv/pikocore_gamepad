    (property "Value" "BTN_L" (at 287.02 135.89 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Button_Switch_THT:SW_Tactile_SPST_Angled_PTS645Vx39-2LFS" (at 287.02 127 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "" (at 287.02 127 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "Tact switch RIGHT ANGLE (C&K PTS645 o equivalente), para los gatillos L y R. A diferencia del vertical tiene SOLO DOS pines electricos: los otros dos contactos del footprint son patas de anclaje mecanico sin numerar, con taladro de 1.30mm (mas gordo que los 0.99 de senal). Esas patas son lo que aguanta el empuje lateral del dedo, que es la carga que recibe un gatillo." (at 287.02 127 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (pin "1" (uuid "b1e7c2a4-9f31-4d6e-8a52-00000000008d"))
