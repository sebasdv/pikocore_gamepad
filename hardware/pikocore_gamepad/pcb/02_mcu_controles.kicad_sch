    (lib_id "pikocore_gamepad:LCD_FPC24")
    (at 134.62 63.5 0)
    (unit 1)
    (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no)
    (uuid "b1e7c2a4-9f31-4d6e-8a52-000000000072")
    (property "Reference" "J4" (at 134.62 24.13 0) (effects (font (size 1.27 1.27))))
    (property "Value" "LCD_FPC" (at 134.62 102.87 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "gamesetup_lcsc:FPC-SMD_24P-P0.50_FPC-05FB-24PH20" (at 134.62 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "https://cdn.shopify.com/s/files/1/0264/7629/files/DM-TFT13-377P24.pdf" (at 134.62 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "Conector FPC 24P a 0.5mm (XUNPU FPC-05FB-24PH20, flip-top, contactos de las dos caras) para el panel DM-TFT13-377 de 24 pines. Pinout del datasheet del panel (LH133T-IF05, rev C): 1=LEDA 2=LEDK 3=GND 4=VDD 5=VDDIO 6=IM(1=4-SPI) 7=RESET 8=CS 9=SCL 10=D/C 11=RD 12=SDA 13..20=DB0..DB7 21=TE 22=NC 23/24=GND. 25/26 son las lenguetas de anclaje del conector. CS va A MASA: siempre seleccionado, como el modulo de 7 pines que reemplaza. ORDEN DE PINES SIN VERIFICAR contra la pieza (LCD_FPC_PIN_ORDER en params.py): si el FPC lleva los contactos hacia arriba, el orden se espeja y J4 va a rot 0 en vez de 180." (at 134.62 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "LCSC" "C2856831" (at 134.62 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
