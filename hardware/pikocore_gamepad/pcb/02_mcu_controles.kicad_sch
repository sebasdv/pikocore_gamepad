    (property "Datasheet" "" (at 198.12 236.22 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "Tact switch RIGHT ANGLE (C&K PTS645 o equivalente), para los gatillos L y R. A diferencia del vertical tiene SOLO DOS pines electricos: los otros dos contactos del footprint son patas de anclaje mecanico sin numerar, con taladro de 1.30mm (mas gordo que los 0.99 de senal). Esas patas son lo que aguanta el empuje lateral del dedo, que es la carga que recibe un gatillo." (at 198.12 236.22 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (pin "1" (uuid "b1e7c2a4-9f31-4d6e-8a52-000000000148"))
