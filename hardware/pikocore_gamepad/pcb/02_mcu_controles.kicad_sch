  (symbol
    (lib_id "pikocore_gamepad:SW_Push")
    (at 287.02 63.5 0)
    (unit 1)
    (exclude_from_sim no) (in_bom yes) (on_board yes) (dnp no)
    (uuid "b1e7c2a4-9f31-4d6e-8a52-000000000091")
    (property "Reference" "SW1" (at 287.02 54.61 0) (effects (font (size 1.27 1.27))))
    (property "Value" "DPAD_UP" (at 287.02 72.39 0) (effects (font (size 1.27 1.27))))
    (property "Footprint" "Button_Switch_THT:SW_PUSH_6mm" (at 287.02 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Datasheet" "" (at 287.02 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "Tact switch 6x6mm THT. Fisicamente tiene 4 patas, pero son DOS PARES cortocircuitados internamente y el contacto une los pares — el datasheet del tact comprado lo dibuja como 1-2 y 3-4. El simbolo declara 2 pines y no 4 porque el footprint oficial de KiCad (SW_PUSH_6mm) numera sus cuatro pads como 1,1,2,2: cada numero aparece dos veces, uno por pata del mismo par. Asi el cableado diagonal —que es lo que garantiza cruzar el contacto— queda imposible de equivocar, porque cualquier pad 1 con cualquier pad 2 ya cruza." (at 287.02 63.5 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (pin "1" (uuid "b1e7c2a4-9f31-4d6e-8a52-000000000092"))
    (pin "2" (uuid "b1e7c2a4-9f31-4d6e-8a52-000000000093"))
    (instances
      (project "pikocore_gamepad"
        (path "/b1e7c2a4-9f31-4d6e-8a52-3c0f7d418e6b/b1e7c2a4-9f31-4d6e-8a52-f00000000001" (reference "SW1") (unit 1))
      )
    )
  )
