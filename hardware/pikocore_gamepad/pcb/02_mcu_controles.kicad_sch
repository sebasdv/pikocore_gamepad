    (symbol "pikocore_gamepad:SW_Push"
      (exclude_from_sim no) (in_bom yes) (on_board yes)
      (property "Reference" "SW" (at 0 7.62 0) (effects (font (size 1.27 1.27))))
      (property "Value" "SW_Push" (at 0 -7.62 0) (effects (font (size 1.27 1.27))))
      (property "Footprint" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Description" "Tact switch 6x6mm THT. Fisicamente tiene 4 patas, pero son DOS PARES cortocircuitados internamente y el contacto une los pares — el datasheet del tact comprado lo dibuja como 1-2 y 3-4. El simbolo declara 2 pines y no 4 porque el footprint oficial de KiCad (SW_PUSH_6mm) numera sus cuatro pads como 1,1,2,2: cada numero aparece dos veces, uno por pata del mismo par. Asi el cableado diagonal —que es lo que garantiza cruzar el contacto— queda imposible de equivocar, porque cualquier pad 1 con cualquier pad 2 ya cruza." (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (symbol "SW_Push_0_1"
        (rectangle (start -7.62 5.08) (end 7.62 -5.08) (stroke (width 0.254) (type default)) (fill (type background)))
      )
      (symbol "SW_Push_1_1"
        (pin passive line (at -7.62 0 0) (length 2.54)
          (name "A" (effects (font (size 1.27 1.27))))
          (number "1" (effects (font (size 1.27 1.27))))
        )
        (pin passive line (at 7.62 0 180) (length 2.54)
          (name "B" (effects (font (size 1.27 1.27))))
          (number "2" (effects (font (size 1.27 1.27))))
        )
      )
    )
    (symbol "pikocore_gamepad:SW_Push_RA"
      (exclude_from_sim no) (in_bom yes) (on_board yes)
      (property "Reference" "SW" (at 0 7.62 0) (effects (font (size 1.27 1.27))))
      (property "Value" "SW_Push_RA" (at 0 -7.62 0) (effects (font (size 1.27 1.27))))
      (property "Footprint" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Datasheet" "" (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (property "Description" "Tact switch RIGHT ANGLE (C&K PTS645 o equivalente), para los gatillos L y R. A diferencia del vertical tiene SOLO DOS pines electricos: los otros dos contactos del footprint son patas de anclaje mecanico sin numerar, con taladro de 1.30mm (mas gordo que los 0.99 de senal). Esas patas son lo que aguanta el empuje lateral del dedo, que es la carga que recibe un gatillo." (at 0 0 0) (effects (font (size 1.27 1.27)) (hide yes)))
      (symbol "SW_Push_RA_0_1"
