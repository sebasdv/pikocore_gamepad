    (comp (ref "U2")
      (value "TPS61023DRLR")
      (footprint "Package_TO_SOT_SMD:SOT-563")
      (datasheet "https://www.ti.com/lit/ds/symlink/tps61023.pdf")
      (description "Boost sincronico, SOT-563 (encapsulado DRL de TI), conmuta 1MHz con Vin>1.5V (lejos de la banda de audio). Alimenta SOLO al PT2308: el riel analogico tiene que ser fijo y no seguir a la bateria. Vin 0.5-5.5V, Vout ajustable 2.2-5.5V. PINOUT VERIFICADO contra TI SLVSF14B (agosto 2020), seccion 5 Pin Configuration and Functions, Figura 5-1 DRL Package 6-Pin SOT563 Top View: 1=FB 2=EN 3=VIN 4=GND 5=SW 6=VOUT. El simbolo de V1 estaba MAL —declaraba VIN/GND/EN + FB/VOUT/SW, o sea 5 de los 6 pines corridos— y el cableado seguia ese error: EN habria quedado a masa, que deja el chip apagado para siempre, y GND en el pin de realimentacion.")
      (fields
        (field (name "LCSC") "C919459")
        (field (name "Footprint") "Package_TO_SOT_SMD:SOT-563")
        (field (name "Datasheet") "https://www.ti.com/lit/ds/symlink/tps61023.pdf")
        (field (name "Description") "Boost sincronico, SOT-563 (encapsulado DRL de TI), conmuta 1MHz con Vin>1.5V (lejos de la banda de audio). Alimenta SOLO al PT2308: el riel analogico tiene que ser fijo y no seguir a la bateria. Vin 0.5-5.5V, Vout ajustable 2.2-5.5V. PINOUT VERIFICADO contra TI SLVSF14B (agosto 2020), seccion 5 Pin Configuration and Functions, Figura 5-1 DRL Package 6-Pin SOT563 Top View: 1=FB 2=EN 3=VIN 4=GND 5=SW 6=VOUT. El simbolo de V1 estaba MAL —declaraba VIN/GND/EN + FB/VOUT/SW, o sea 5 de los 6 pines corridos— y el cableado seguia ese error: EN habria quedado a masa, que deja el chip apagado para siempre, y GND en el pin de realimentacion."))
      (libsource (lib "pikocore_gamepad") (part "TPS61023") (description "Boost sincronico, SOT-563 (encapsulado DRL de TI), conmuta 1MHz con Vin>1.5V (lejos de la banda de audio). Alimenta SOLO al PT2308: el riel analogico tiene que ser fijo y no seguir a la bateria. Vin 0.5-5.5V, Vout ajustable 2.2-5.5V. PINOUT VERIFICADO contra TI SLVSF14B (agosto 2020), seccion 5 Pin Configuration and Functions, Figura 5-1 DRL Package 6-Pin SOT563 Top View: 1=FB 2=EN 3=VIN 4=GND 5=SW 6=VOUT. El simbolo de V1 estaba MAL —declaraba VIN/GND/EN + FB/VOUT/SW, o sea 5 de los 6 pines corridos— y el cableado seguia ese error: EN habria quedado a masa, que deja el chip apagado para siempre, y GND en el pin de realimentacion."))
      (property (name "LCSC") (value "C919459"))
      (property (name "Sheetname") (value "Alimentacion - USB, carga, 3V3, boost 5V y encendido"))
      (property (name "Sheetfile") (value "01_alimentacion.kicad_sch"))
      (sheetpath (names "/Alimentacion - USB, carga, 3V3, boost 5V y encendido/") (tstamps "/b1e7c2a4-9f31-4d6e-8a52-f00000000000/"))
      (tstamps "b1e7c2a4-9f31-4d6e-8a52-000000000032"))
    (comp (ref "U7")
      (value "TPS63001DRCR")
      (footprint "Package_SON:Texas_DRC0010J_ThermalVias")
      (datasheet "https://www.ti.com/lit/ds/symlink/tps63001.pdf")
      (description "Buck-boost TI TPS63001DRCR, salida FIJA 3.3V hasta 1.2A, VIN 1.8-5.5V, VSON-10 3x3. Pinout verificado contra SLVS520C: 1=VOUT 2=L2 3=PGND 4=L1 5=VIN 6=EN 7=PS/SYNC 8=VINA 9=GND 10=FB (a VOUT en la version fija), pad expuesto (11) a PGND. Reemplaza al MP28164 del modulo, que no tiene huella en KiCad ni en EasyEDA.")
      (fields
        (field (name "LCSC") "C28060")
        (field (name "Footprint") "Package_SON:Texas_DRC0010J_ThermalVias")
