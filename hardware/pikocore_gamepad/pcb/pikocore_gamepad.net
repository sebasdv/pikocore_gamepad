    (comp (ref "J1")
      (value "PHONES")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical")
      (description "Jack 3.5mm estereo THT con contacto de deteccion NC. El pin DET va a JACK_DET con pull-up: el firmware apaga el parlante al detectar plug. Se decide por firmware y no por hardware a proposito — permite politicas como 'auriculares puestos pero quiero oir el parlante igual', que un corte mecanico prohibe. PINOUT SIN VERIFICAR: la parte todavia no esta elegida (V-3).")
      (fields
        (field (name "Footprint") "Connector_PinHeader_2.54mm:PinHeader_1x04_P2.54mm_Vertical")
