# Prerequisites
pico-sdk/
*.d

# CMake/build output. This fork's release artifact is the GamePi13 build
# (build-gamepi/, below); the stock-hardware build isn't published here.
build/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json

# Web dependencies and local caches. Keep web/dist trackable for the static site.
web/node_modules/
web/.vite/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# macOS
.DS_Store

# GamePi13 build output. Keep the released UF2 artifact trackable -- this is
# the binary someone can grab straight off the repo without compiling.
build-gamepi/*
!build-gamepi/
!build-gamepi/pikocore.uf2

.superpowers/

# Raw Lopaka (lopaka.app) tool exports dropped into src/gamepi13/ while
# designing LCD UI assets. Scratch material only -- the parsed/renamed data
# that's actually compiled lives in ui_bitmaps.h and splash_logo.h.
src/gamepi13/*.txt
